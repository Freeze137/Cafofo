# ─────────────────────────────────────────────────────────────
# Credenciais do Firebase (OPCIONAL)
# Copie este arquivo para `.env` e preencha com as chaves do seu
# projeto Firebase para ativar o backend real (Auth + Firestore).
#
# O app FUNCIONA SEM ISTO: por padrão usa um backend local
# (localStorage) para que rode imediatamente, sem configuração.
# Veja src/services/* e src/firebase/firebase.js.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
