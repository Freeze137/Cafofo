# Porta da API
PORT=3333

# Segredo usado para assinar os tokens de sessão (JWT).
# Gere um valor longo e aleatório, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, a API usa um segredo temporário e as sessões caem a cada reinício.
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Validade do token de sessão
JWT_EXPIRES_IN=8h
